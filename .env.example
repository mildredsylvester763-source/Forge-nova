# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genesis?schema=public
DATABASE_POOL_TIMEOUT_SECONDS=10
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3001
JWT_ACCESS_SECRET=local-development-only-change-this-secret-32-chars-minimum
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Production secrets must come from a secret manager, not this file.

# AI provider credentials are optional until you enable that provider.
# Never expose these values to clients or commit real keys.
# OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
# GOOGLE_AI_API_KEY=
GOOGLE_AI_DEFAULT_MODEL=gemini-2.5-flash
# MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=mistral-small-latest
AI_PROVIDER_TIMEOUT_MS=60000
AI_PROVIDER_PRIORITY=openai,anthropic,google,mistral

EXECUTION_WORKER_ENABLED=true
EXECUTION_WORKER_POLL_MS=1000
EXECUTION_WORKER_LEASE_MS=60000
