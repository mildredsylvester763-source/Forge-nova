# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/genesis?schema=public
DATABASE_POOL_TIMEOUT_SECONDS=10
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3001
# Configure only when the corresponding provider adapter is implemented.
# ENCRYPTION_KEY=replace-with-a-secret-from-a-secret-manager
